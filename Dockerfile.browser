# Variant with on-server Turnstile harvesting (Xvfb + Chromium).
# Heavy: needs a Render instance with >= 1 GB RAM. Set ENABLE_BROWSER_HARVEST=1.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb ca-certificates fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-browser.txt .
RUN pip install -r requirements-browser.txt \
    && playwright install --with-deps chromium

COPY app ./app
COPY docker/browser-entrypoint.sh /usr/local/bin/browser-entrypoint.sh
RUN chmod +x /usr/local/bin/browser-entrypoint.sh

EXPOSE 8000

CMD ["browser-entrypoint.sh"]
